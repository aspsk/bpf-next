menuconfig LLVM_PLUGINS
	bool "LLVM plugins"
	depends on CC_IS_CLANG
	depends on $(success,$(LLVM_CONFIG) --version)
	default y
	help
	  LLVM plugins add compiler passes to kernel and module builds.
	  Building them requires matching LLVM development headers and
	  llvm-config.

if LLVM_PLUGINS

config CLANG_PLUGIN_BPF_SCAN_IR
	bool "Scan optimized LLVM IR for BPF"
	depends on DEBUG_INFO_BTF
	depends on !LTO_CLANG
	default y
	help
	  Run bpf_scan_ir at optimizer-last to collect metadata for BPF.
	  The current analysis discovers fmod_ret candidates.

	  Describe functions, calls, callback arguments, clean prefixes and errno
	  propagation in one build-only ELF section. The resolve_btfids tool derives
	  clean functions and admits functions only when every negative errno
	  propagates through all callers to a syscall table entry or is reported
	  through netlink_ack(), or is handled by netlink_rcv_skb callback dispatch.

	  Function addresses passed to direct calls and forwarded through callback
	  parameters are resolved when every use of the pointer is accounted for.
	  Taking an address is diagnostic and does not itself exclude a function.
	  Compiler retention annotations do not count as runtime address escapes.
	  Unknown callers, untracked address escapes and unproved cycles are rejected.
	  This analysis currently requires a non-LTO build, so descriptions refer
	  to the final optimized functions in each compilation unit.

endif
