config CLANG_PLUGIN_FMODRET_CANDIDATES
	bool "Generate fmod_ret candidate metadata with LLVM"
	depends on CC_IS_CLANG && DEBUG_INFO_BTF
	depends on $(success,$(LLVM_CONFIG) --version)
	default y
	help
	  Emit compiler-derived references to functions which may return a Linux
	  errno. The BTF generation tools use this metadata to construct the
	  fmod_ret allow-list.
